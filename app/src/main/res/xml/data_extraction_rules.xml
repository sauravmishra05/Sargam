<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive authentication cookies, tokens, and preferences -->
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="file"
            path="datastore" />

        <!-- Exclude large media caches and temporary playback files -->
        <exclude
            domain="file"
            path="./exoplayer" />
        <exclude
            domain="file"
            path="./download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude sensitive authentication cookies, tokens, and preferences -->
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="file"
            path="datastore" />

        <!-- Exclude large media caches and temporary playback files -->
        <exclude
            domain="file"
            path="./exoplayer" />
        <exclude
            domain="file"
            path="./download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
    </device-transfer>
</data-extraction-rules>